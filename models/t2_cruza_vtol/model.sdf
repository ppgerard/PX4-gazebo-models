<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.5'>
  <model name='t2_cruza_vtol'>
    <pose>0 0 0.1 0 0 0</pose>
    <link name='base_link'>
      <pose>0 0 0 0 0 0</pose>
      <!-- Required for the world's wind to reach this link: both the
           WindEffects drag force and the LiftDrag surfaces below (all of which
           are attached to base_link) only account for wind when the link has
           the WindMode component enabled. Without this, a windy world has
           almost no effect on the vehicle. -->
      <enable_wind>true</enable_wind>
      <inertial>
        <!-- The airframe's lumped centre of mass, which is NOT the model origin
             minus this offset by accident: it is what puts the COMPOSITE centre
             of mass ON the origin, and both control allocations require that.
             PX4's own mixer takes CA_ROTOR*_PX/PY relative to the centre of mass
             and is given 0.20 / -0.40, exactly the rotor link positions, so it
             assumes the CG is the origin. This node's allocation assumes +18.5 mm
             (front arm 0.1815 against a rotor at +0.20).
             With base_link's 2.37 kg lumped AT the origin the composite CG sat at
             +8.09 mm, because the two tilting front nacelles carry 0.05 kg each
             at +0.20 while the tail rotor has no motor link at all: rotor_2_joint
             goes straight from base_link to rotor_2, so the tail motor's mass is
             inside this lump and has to be placed with it. -0.008481 m puts the
             composite CG at the origin, which makes PX4 correct and lets this
             node use the true arms (0.20 / 0.40). -->
        <pose>-0.008481 0 0 0 0 0</pose>
        <!-- without payload : -->
        <!-- <mass>2.220</mass>
        <inertia>
          <ixx>0.08384</ixx>
          <iyy>0.12102</iyy>
          <izz>0.20216</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia> -->
        <!-- with payload : -->
        <mass>2.37</mass>
        <inertia>
          <ixx>0.0808685</ixx>
          <iyy>0.1256707</iyy>
          <izz>0.2036992</izz>
          <ixy>0</ixy>
          <ixz>0.0</ixz>
          <!-- <ixz>0.0025341</ixz> -->
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name='base_link_collision'>
        <pose>-0.01 0 -0.08 0 0 0</pose>
        <geometry>
          <box>
            <size>0.55 2.144 0.05</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>1.0</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='base_link_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://t2_cruza_vtol/meshes/fuselage.dae</uri>
          </mesh>
        </geometry>
        <material> <!-- DarkGrey-->
          <ambient>0.175 0.175 0.175 1.0</ambient>
          <diffuse>0.175 0.175 0.175 1.0</diffuse>
        </material>
      </visual>
      <visual name='motor_2'>
        <pose>-0.40 0 0.01 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.035</length>
            <radius>0.02</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>.175 .175 .175 1.0</ambient>
          <diffuse>.175 .175 .175 1.0</diffuse>
        </material>
      </visual>

      <gravity>1</gravity>
      <velocity_decay/>
      <self_collide>0</self_collide>

      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

